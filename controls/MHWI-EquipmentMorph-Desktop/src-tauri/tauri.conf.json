{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MHWI EquipmentMorph",
  "version": "0.2.0",
  "identifier": "io.github.mi1ice.equipmentmorph",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../../.build/control-center-web"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "MHWI-EquipmentMorph · 装备形态键",
      "width": 1120, "height": 760, "minWidth": 680, "minHeight": 560,
      "visible": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": { "active": false, "icon": [] }
}
